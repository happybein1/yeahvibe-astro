---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Head.astro';

// Starlight 0.32+ passes route data via Astro.locals, not props.
const route = Astro.locals.starlightRoute;
const { entry, lang } = route;

// Drop Starlight's own title/description/canonical/OG/Twitter tags; this file sets them below.
// Without this, every page carried two sets and the site-wide defaults won over the article's own.
route.head = route.head.filter((t) => {
  const a = t.attrs || {};
  if (t.tag === 'title') return false;
  if (t.tag === 'link' && a.rel === 'canonical') return false;
  if (t.tag === 'meta' && (a.name === 'description' || String(a.property || '').startsWith('og:') || String(a.name || '').startsWith('twitter:'))) return false;
  return true;
});

const siteUrl = 'https://yeahcore.happybein.com';
const currentPath = Astro.url.pathname;
const currentUrl = new URL(currentPath, siteUrl).toString();
const ogImage = `${siteUrl}/og-card.png`;
// 2.28.0 (owner, 2026-11-04): Spanish and Dutch join French. One entry per language; English is the fallback.
const LOC: Record<string, { site: string; home: string; desc: string; kw: string; og: string }> = {
  en: { site: 'YeahCore by HappyBein', home: 'YeahCore — What people need, and how to decide',
    desc: 'YeahCore is the HappyBein knowledge base: the human needs and drivers behind what people want, and practical frameworks for better decisions, personal effectiveness, organization and leadership.',
    kw: 'decision making, human needs, personal effectiveness, productivity, leadership, self improvement, YeahCore, HappyBein, habits, mindset, organization', og: 'en_US' },
  fr: { site: 'YeahCore par HappyBein', home: 'YeahCore — Ce dont chacun a besoin, et comment décider',
    desc: 'YeahCore est la base de connaissances de HappyBein : les besoins et moteurs humains derrière ce que veulent les gens, et des cadres pratiques pour mieux décider, l\'efficacité personnelle, l\'organisation et le leadership.',
    kw: 'prise de décision, besoins humains, efficacité personnelle, productivité, leadership, développement personnel, YeahCore, HappyBein, habitudes, état d\'esprit', og: 'fr_FR' },
  es: { site: 'YeahCore de HappyBein', home: 'YeahCore — Lo que las personas necesitan, y cómo decidir',
    desc: 'YeahCore es la base de conocimiento de HappyBein: las necesidades humanas y los motores detrás de lo que la gente quiere, y métodos prácticos para decidir mejor, la eficacia personal, la organización y el liderazgo.',
    kw: 'toma de decisiones, necesidades humanas, eficacia personal, productividad, liderazgo, desarrollo personal, YeahCore, HappyBein, hábitos, mentalidad', og: 'es_ES' },
  nl: { site: 'YeahCore van HappyBein', home: 'YeahCore — Wat mensen nodig hebben, en hoe je beslist',
    desc: 'YeahCore is de kennisbank van HappyBein: de menselijke behoeften en drijfveren achter wat mensen willen, en praktische methoden om beter te beslissen, voor persoonlijke effectiviteit, organiseren en leiderschap.',
    kw: 'beslissingen nemen, menselijke behoeften, persoonlijke effectiviteit, productiviteit, leiderschap, persoonlijke ontwikkeling, YeahCore, HappyBein, gewoonten, mindset', og: 'nl_NL' },
};
const loc = LOC[lang] ?? LOC.en;

// Page title — append site name for SEO unless it's already the homepage
const rawTitle = entry?.data?.title ?? 'YeahCore';
const basePath = currentPath.replace(/^\/(fr|es|nl)(\/|$)/, '/');
const isHome = basePath === '/';
const seoTitle = isHome ? loc.home : `${rawTitle} | ${loc.site}`;

// Meta description — richer default with keywords
const description = entry?.data?.description ?? loc.desc;


// x-default hreflang: the English page
const enUrl = `${siteUrl}${basePath}`;
---
<Default {...Astro.props} />

<!-- Favicons — override Starlight default -->
<link rel="icon" type="image/x-icon" href="/favicon.ico" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<!-- SEO Core -->
<title>{seoTitle}</title>
<meta name="description" content={description} />
<meta name="keywords" content={loc.kw} />
<meta name="author" content="YeahCore — HappyBein" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<meta name="theme-color" content="#0e7fbe" />

<!-- Canonical -->
<link rel="canonical" href={currentUrl} />

<!-- Hreflang -->
<!-- 2.28.0: Starlight already adds one hreflang link per language; only x-default is added here. -->
<link rel="alternate" hreflang="x-default" href={enUrl} />

<!-- Open Graph -->
<meta property="og:title" content={seoTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={currentUrl} />
<meta property="og:type" content="website" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="2400" />
<meta property="og:image:height" content="1260" />
<meta property="og:image:alt" content="YeahCore — What people need, and how to decide" />
<meta property="og:locale" content={loc.og} />
{Object.values(LOC).filter((x) => x.og !== loc.og).map((x) => <meta property="og:locale:alternate" content={x.og} />)}
<meta property="og:site_name" content={loc.site} />

<!-- Twitter / X Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={seoTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content="YeahCore — What people need, and how to decide" />
<meta name="twitter:site" content="@yeahvibe" />
<meta name="twitter:creator" content="@happybein" />

<!-- Google Analytics -->
<!-- Visit counts (Cloudflare Web Analytics, cookieless) + owner-traffic marker (yv-internal v5; source: _shared/internal.js) -->
<script is:inline>
  (function (w, d) {
    var p = w.location.hostname.split('.'), dom = p.length >= 2 && !/^[\d.]+$/.test(w.location.hostname) ? '; domain=.' + p.slice(-2).join('.') : '';
    var here = p.slice(-2).join('.');
    var m = (w.location.search.match(/[?&]internal(?:=([^&]*))?(?:&|$)/) || [])[0], on = null;
    if (m) on = !/=off/.test(m);
    if (on !== null) {
      try { d.cookie = 'yv_internal=' + (on ? '1' : '') + '; max-age=' + (on ? 31536000 : 0) + '; path=/' + dom + '; SameSite=Lax' + (w.location.protocol === 'https:' ? '; Secure' : ''); } catch (e) {}
      try { if (on) w.localStorage.setItem('yv_internal', '1'); else w.localStorage.removeItem('yv_internal'); } catch (e) {}
    }
    var internal = false;
    try { internal = w.localStorage.getItem('yv_internal') === '1'; } catch (e) {}
    if (!internal) internal = /(?:^|;\s*)yv_internal=1/.test(d.cookie || '');
    if (here !== 'yeahvibe.com') {
      try {
        d.cookie.split('; ').map(function (c) { return c.split('=')[0]; })
          .filter(function (n) { return n === '_ga' || n.indexOf('_ga_') === 0 || n === '_gid' || n === 'yv_consent'; })
          .forEach(function (n) { ['', '; domain=' + w.location.hostname, dom].forEach(function (x) { d.cookie = n + '=; expires=Thu, 01 Jan 1970 00:00:00 GMT; path=/' + x; }); });
        w.localStorage.removeItem('yv_consent');
      } catch (e) {}
    }
    var CF = { 'happybein.com': 'bc29302dbc214188aebf56490bf4cef4', 'yeahdev.com': 'eb13518849014d5e9fd376c4202f3432', 'yeahvibe.com': '55aea6e64e384cf7b021e272ff38d389' }[here];
    if (CF && !internal) {
      var b = d.createElement('script');
      b.defer = true; b.src = 'https://static.cloudflareinsights.com/beacon.min.js';
      b.setAttribute('data-cf-beacon', JSON.stringify({ token: CF }));
      (d.head || d.documentElement).appendChild(b);
    }
    if (on === null && !internal) return;
    var others = ['happybein.com', 'yeahvibe.com', 'yeahdev.com'].filter(function (x) { return x !== here; });
    var A = 'style="color:#6fdcd8"';
    function pill() {
      if (!internal) return;
      var v = d.querySelector('#version-refresh, .yv-version, .header-version, .ver, .version');
      if (v) {
        var cs = w.getComputedStyle(v), dot = d.createElement('span');
        if (cs.position === 'static') v.style.position = 'relative';
        dot.setAttribute('aria-hidden', 'true');
        dot.style.cssText = 'position:absolute;left:50%;top:calc(100% - ' + (parseFloat(cs.paddingBottom) || 0) + 'px + 1px);width:5px;height:5px;margin-left:-2.5px;border-radius:50%;background:#2ABFBF;pointer-events:none';
        v.appendChild(dot);
        v.title = (v.title ? v.title + ' · ' : '') + 'Internal: your visits are not counted in the analytics';
        return;
      }
      var b = d.createElement('button');
      b.type = 'button';
      b.innerHTML = '&#9679; internal';
      b.title = 'This browser is marked as internal: your visits are not counted in the analytics';
      b.style.cssText = 'position:fixed;left:8px;bottom:calc(env(safe-area-inset-bottom,0px) + 8px);z-index:2147482999;padding:3px 9px;border-radius:999px;border:0;font:600 11px/1.4 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:#1A3333;color:#6fdcd8;opacity:.75;cursor:pointer';
      b.onclick = function () { b.remove(); note(true); };
      d.body.appendChild(b);
    }
    function note(info) {
      var n = d.createElement('div');
      n.setAttribute('role', 'status');
      n.style.cssText = 'position:fixed;left:12px;right:12px;top:calc(env(safe-area-inset-top,0px) + 12px);z-index:2147483001;max-width:520px;margin:0 auto;padding:12px 16px;border-radius:12px;font:14px/1.45 system-ui,-apple-system,Segoe UI,Roboto,sans-serif;background:#1A3333;color:#fff;box-shadow:0 6px 28px rgba(0,0,0,.28)';
      n.innerHTML = (info ? 'This browser is marked as <b>internal</b> on ' + here + ': your visits are left out of the analytics. <a ' + A + ' href="' + w.location.pathname + '?internal=off">Remove the mark</a>'
                   : on ? '&#10003; This browser is now marked as <b>internal</b> on ' + here + ': your visits are left out of the analytics.'
                        : 'The internal mark is removed on ' + here + ': your visits count again.') +
        (info ? '' : ' Also on: ' + others.map(function (x) { return '<a ' + A + ' href="https://' + x + '/?internal' + (on ? '' : '=off') + '">' + x + '</a>'; }).join(' &middot; ')) +
        ' <button type="button" aria-label="Close" style="float:right;background:none;border:0;color:#fff;font-size:18px;cursor:pointer">&times;</button>';
      n.querySelector('button').onclick = function () { n.remove(); pill(); };
      d.body.appendChild(n);
    }
    var show = function () { if (on === null) pill(); else note(false); };
    if (d.body) show(); else d.addEventListener('DOMContentLoaded', show);
  })(window, document);
</script>

<!-- Language preference storage + auto-detection on first visit -->
<script>
  (function() {
    const path = window.location.pathname;
    // 2.28.0: French, Spanish and Dutch.
    const m = path.match(/^\/(fr|es|nl)(\/|$)/);
    const here = m ? m[1] : 'en';
    let stored = null;
    try { stored = localStorage.getItem('yv-lang'); } catch (e) {}

    // Auto-redirect only on a first visit to the root (no stored preference yet)
    if (path === '/' && !stored) {
      const nav = (navigator.language || 'en').toLowerCase().slice(0, 2);
      if (nav === 'fr' || nav === 'es' || nav === 'nl') {
        try { localStorage.setItem('yv-lang', nav); } catch (e) {}
        window.location.replace('/' + nav + '/');
        return;
      }
    }
    // Otherwise remember the language of the page being read
    try { localStorage.setItem('yv-lang', here); } catch (e) {}
  })();
</script>

<!-- Collapse sidebar groups by default, keep active one open -->
<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Find all sidebar group <details> elements
    const sidebarDetails = document.querySelectorAll('.sidebar-content details');
    sidebarDetails.forEach(function(detail) {
      // Check if any link inside is the current page
      const currentLink = detail.querySelector('a[aria-current="page"]');
      if (!currentLink) {
        detail.removeAttribute('open');
      }
    });
  });
</script>

<!-- 2.21.0: "Listen" buttons on situation pages play the guide's podcast in place (one at a time) -->
<script>
  (function () {
    let audio = null, btn = null;
    const fmt = (s) => Math.floor(s / 60) + ':' + String(Math.floor(s % 60)).padStart(2, '0');
    const label = (b, playing) => {
      if (b.classList.contains('yv-listen--icon')) { b.textContent = playing ? '❚❚' : '🎧'; b.classList.toggle('is-playing', playing); return; }
      const base = b.dataset.label || (b.dataset.label = b.textContent.replace(/^[▶❚\s]+/, ''));
      b.textContent = (playing ? '❚❚ ' : '▶ ') + (playing && audio && audio.currentTime > 0 ? fmt(audio.currentTime) + ' / ' + fmt(audio.duration || 0) : base);
      b.classList.toggle('is-playing', playing);
    };
    document.addEventListener('click', (e) => {
      const b = e.target.closest && e.target.closest('.yv-listen');
      if (!b) return;
      if (btn && btn !== b) { audio.pause(); label(btn, false); audio = null; }
      if (!audio) {
        btn = b; audio = new Audio(b.dataset.src);
        audio.addEventListener('timeupdate', () => label(b, !audio.paused));
        audio.addEventListener('ended', () => { audio.currentTime = 0; label(b, false); });
      }
      if (audio.paused) { audio.play().catch(() => {}); label(b, true); } else { audio.pause(); label(b, false); }
    });
  })();
</script>

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "YeahCore",
  "url": siteUrl,
  "description": "The human needs behind what people want, and practical decision-making frameworks — in English, French, Spanish and Dutch. By HappyBein.",
  "inLanguage": ["en", "fr", "es", "nl"]
})} />

